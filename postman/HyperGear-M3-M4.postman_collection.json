{
  "info": {
    "name": "HyperGear M3–M4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on LOCAL demo only, in order. Admin credentials are seeded demo accounts. No Gemini key belongs here. Creates a temporary product/category/comment and soft-archives product. AI model depends server .env. Native Mongo search fallback is honest; full Docker verifies Elasticsearch."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "item": [
    {
      "name": "01 Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-HyperGear-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"HyperGear@2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Admin customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-HyperGear-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/admin/users?page=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Pagination',()=>pm.expect(pm.response.json().items.length).to.be.at.most(20));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Admin products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-HyperGear-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/catalog/admin/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const p=pm.response.json().items[0]; pm.collectionVariables.set('productId',p._id); const body=JSON.parse(JSON.stringify(p));delete body._id;body.slug='postman-m3-'+Date.now();body.name='Postman Temporary Demo';body.variants.forEach((v,i)=>v.sku=body.slug+'-'+i);pm.collectionVariables.set('newProductBody',JSON.stringify(body));pm.collectionVariables.set('newSlug',body.slug);pm.collectionVariables.set('newCategory','Postman QA '+Date.now());"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-HyperGear-Client",
            "value": "web"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/catalog/admin/products",
        "body": {
          "mode": "raw",
          "raw": "{{newProductBody}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('createdProductId',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
