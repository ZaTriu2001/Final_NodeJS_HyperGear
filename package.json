{
  "name": "hypergear-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js microservices e-commerce project for computers and components",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hypergear/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @hypergear/web",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "seed": "node scripts/seed.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.mjs",
    "demo:local": "node scripts/local-demo.mjs",
    "demo:setup": "node scripts/setup.mjs",
    "test:messaging": "node --test tests/messaging.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "mongodb-memory-server": "^10.2.3"
  }
}
